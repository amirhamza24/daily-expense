// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id                     String     @id @default(uuid())
  name                   String
  email                  String     @unique
  password               String
  role                   Role       @default(USER)
  status                 UserStatus @default(PENDING)
  approvedAt             DateTime?
  approvedBy             String?
  emailVerified          Boolean    @default(false)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  // Password reset: SHA-256 of the emailed 6-digit code (never the code itself),
  // its expiry, and failed attempts — the code is burned after too many misses.
  resetCodeHash          String?
  resetCodeExpiry        DateTime?
  resetAttempts          Int        @default(0)
  createdAt              DateTime   @default(now())
  
  expenses               Expense[]
  balance                Balance?
  moneyRecords           MoneyRecord[]
}

model Expense {
  id          String   @id @default(uuid())
  title       String
  amount      Float
  category    String
  note        String?
  expenseDate DateTime
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  // Optional breakdown of a single debit into several reasons.
  // `amount` above stays the total; splits must not exceed it.
  splits      ExpenseSplit[]
}

model ExpenseSplit {
  id        String  @id @default(uuid())
  title     String
  amount    Float
  position  Int     @default(0)

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String

  @@index([expenseId])
}

model Balance {
  id               String   @id @default(uuid())
  totalBalance     Float    @default(0)
  remainingBalance Float    @default(0)
  note             String   @default("")
  
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String   @unique
}

// ─── Lending & borrowing ─────────────────────────────────────────────────────
// Kept apart from Expense: neither side is income or spending.
//   LENT     — I gave money; it comes back as repayments (receivable).
//   BORROWED — I received money; it goes back as payments (payable).
// Both move Balance.remainingBalance (see src/actions/money.ts).

enum MoneyRecordType {
  LENT
  BORROWED
}

// Settlement progress only. "Overdue" depends on today's date, so it is
// derived at read time from dueDate + status and never stored.
enum MoneyRecordStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

model MoneyRecord {
  id         String            @id @default(uuid())
  type       MoneyRecordType
  personName String
  amount     Float
  // Sum of payments, kept in sync with `payments` inside a transaction
  paidAmount Float             @default(0)
  date       DateTime
  dueDate    DateTime?
  note       String?
  status     MoneyRecordStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  payments   MoneyPayment[]

  @@index([userId, type, status])
  @@index([userId, date])
  @@index([userId, dueDate])
}

model MoneyPayment {
  id            String      @id @default(uuid())
  amount        Float
  paymentDate   DateTime
  note          String?
  createdAt     DateTime    @default(now())

  moneyRecord   MoneyRecord @relation(fields: [moneyRecordId], references: [id], onDelete: Cascade)
  moneyRecordId String

  @@index([moneyRecordId, paymentDate])
}
